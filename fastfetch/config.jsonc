{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 1,
      "left": 3,
      "right": 4
    },
    "color": {
      "1": "cyan"
    }
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[37m┌─\u001b[0m"
    },
    {
      "type": "os",
      "key": "\u001b[37m│\u001b[0m  \u001b[36m󰣇 OS\u001b[0m",
      "format": "{2}"
    },
    {
      "type": "packages",
      "key": "\u001b[37m│\u001b[0m  \u001b[34m󰏗 Packages\u001b[0m",
    },
    {
      "type": "wm",
      "key": "\u001b[37m│\u001b[0m  \u001b[35m󱗃 WM\u001b[0m",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "\u001b[37m│\u001b[0m  \u001b[33m Memory\u001b[0m",
      "format": "{/1}{-}{/}{/2}{-}{/}{} / {}"
    },
    {
      "type": "command",
      "key": "\u001b[37m│\u001b[0m  \u001b[32m󱦟 OS Age\u001b[0m",
      "text": "echo $(( ($(date +%s) - $(stat -c %W / 2>/dev/null || stat -c %Y /)) / 86400 ))d"
    },
    {
      "type": "uptime",
      "key": "\u001b[37m│\u001b[0m  \u001b[31m󱫐 Uptime\u001b[0m",
      "format": "{2}h {3}m"
    },
    {
      "type": "colors",
      "key": "\u001b[37m│\u001b[0m  \u001b[90m󰏘 Colors\u001b[0m",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "\u001b[37m└─\u001b[0m"
    }
  ]
}
