{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    },
    "color": {
      "1": "cyan"
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "cyan",
        "at": "white",
        "host": "blue"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[90m─────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "󰣇 ",
      "keyColor": "cyan",
      "format": "{2}"
    },
    {
      "type": "wm",
      "key": "󱗃 ",
      "keyColor": "blue",
      "format": "{2}"
    },
    {
      "type": "packages",
      "key": "󰏗 ",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "󱫐 ",
      "keyColor": "blue",
      "format": "{2}h {3}m"
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "cyan",
      "format": "{1} / {2}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
